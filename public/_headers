# Cloudflare Pages/Workers applies these to the deployed static assets.
# A static export cannot set headers from next.config.mjs, so they live here.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  # Everything is same-origin and self-contained: no third-party scripts, no
  # remote images, no XHR. 'unsafe-inline' covers Next's inline bootstrap and
  # the styles Tailwind emits inline; data: covers the inlined font subsets.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# The worker must never be pinned by an HTTP cache, or a deploy cannot roll out.
/sw.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: no-cache, no-store, must-revalidate

# Content-hashed, so safe to keep forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
