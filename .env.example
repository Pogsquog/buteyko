# Copy to .env.local. Both values are safe to publish — they are inlined into the
# static export, and row-level security is what protects the data.
#
# Leave these unset to run the app entirely local-only: with no Supabase configured
# the sync layer stays dormant and the account screen says so.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
